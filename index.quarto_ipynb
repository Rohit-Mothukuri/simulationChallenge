      "source": [
        "#| label: q4-prob-original-py\n",
        "#| echo: false\n",
        "#| warning: false\n",
        "#| fig-cap: Probability of final balance > $30,000 at age 75\n",
        "\n",
        "# Calculate probability from the 100 simulations (same as section 3)\n",
        "import numpy as np\n",
        "\n",
        "# Set seed for reproducibility (same as section 3)\n",
        "np.random.seed(42)\n",
        "\n",
        "# Parameters\n",
        "initial_investment = 30000\n",
        "years = 40\n",
        "n_simulations = 100\n",
        "\n",
        "# Run simulations (same as section 3)\n",
        "final_balances = []\n",
        "for sim in range(n_simulations):\n",
        "    current_balance = initial_investment\n",
        "    for year in range(years):\n",
        "        coin_flip = np.random.binomial(1, 0.5)\n",
        "        if coin_flip == 1:\n",
        "            current_balance *= 1.5  # +50% increase\n",
        "        else:\n",
        "            current_balance *= 0.6  # -40% decrease\n",
        "    final_balances.append(current_balance)\n",
        "\n",
        "final_balances = np.array(final_balances)\n",
        "\n",
        "# Calculate probability estimate\n",
        "prob_above_30k = np.mean(final_balances > initial_investment)\n",
        "\n",
        "# Print results with 3 decimals\n",
        "print(f\"\\nProbability Estimate:\")\n",
        "print(f\"P(final balance > ${initial_investment:,}) = {prob_above_30k:.3f} ({prob_above_30k*100:.1f}%)\")\n",
        "print(f\"\\nInterpretation:\")\n",
        "print(f\"- {prob_above_30k*100:.1f}% of simulations ended above the initial investment\")\n",
        "print(f\"- {100-prob_above_30k*100:.1f}% of simulations resulted in losses\")"
      ],
