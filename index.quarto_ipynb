        "#| echo: false\n",
        "#| warning: false\n",
        "#| label: fig-investment-dag\n",
        "#| fig-cap: Generative DAG model for the investment game showing how wealth evolves over time through coin flips\n",
        "investmentDAG.show()"
      ],
