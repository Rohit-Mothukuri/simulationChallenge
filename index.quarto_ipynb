    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "#| label: q3-dist-100-py\n",
        "#| fig-cap: Distribution of final balances across 100 simulations\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Set seed for reproducibility\n",
        "np.random.seed(42)\n",
        "\n",
        "# Parameters\n",
        "initial_balance = 30000\n",
        "years = 40  # Starting at age 35, playing until 75\n",
        "n_simulations = 100\n",
        "\n",
        "# Run 100 simulations\n",
        "final_balances = []\n",
        "\n",
        "for sim in range(n_simulations):\n",
        "    current_balance = initial_balance\n",
        "    for year in range(years):\n",
        "        coin_flip = np.random.binomial(1, 0.5)  # 1 = heads, 0 = tails\n",
        "        if coin_flip == 1:\n",
        "            current_balance *= 1.5  # +50% increase\n",
        "        else:\n",
        "            current_balance *= 0.6  # -40% decrease\n",
        "    final_balances.append(current_balance)\n",
        "\n",
        "final_balances = np.array(final_balances)\n",
        "\n",
        "# Calculate statistics\n",
        "mean_balance = np.mean(final_balances)\n",
        "median_balance = np.median(final_balances)\n",
        "prob_above_30k = np.mean(final_balances > initial_balance)\n",
        "\n",
        "# Create histogram with log scale (powers of 10)\n",
        "fig, ax = plt.subplots(figsize=(7, 5))\n",
        "\n",
        "# Create log-spaced bins for better distribution visualization\n",
        "log_bins = np.logspace(np.log10(max(1, np.min(final_balances[final_balances > 0])) * 0.9),\n",
        "                       np.log10(np.max(final_balances) * 1.1), 30)\n",
        "\n",
        "# Create histogram with meaningful bins and color coding\n",
        "n, bins, patches = ax.hist(final_balances, bins=log_bins, edgecolor='black', \n",
        "                           linewidth=1.2, alpha=0.85, color='steelblue')\n",
        "\n",
        "ax.set_xscale('log')\n",
        "\n",
        "# Set x-axis limits\n",
        "xlim_min = max(1, np.min(final_balances[final_balances > 0]) * 0.8)\n",
        "xlim_max = np.max(final_balances) * 1.2\n",
        "ax.set_xlim(xlim_min, xlim_max)\n",
        "\n",
        "# Format x-axis with amounts in K format\n",
        "def format_k(x, p):\n",
        "    if x >= 1000:\n",
        "        return f'${x/1000:.0f}K'\n",
        "    else:\n",
        "        return f'${x:.0f}'\n",
        "ax.xaxis.set_major_formatter(plt.FuncFormatter(format_k))\n",
        "\n",
        "# Add reference lines with K format labels\n",
        "initial_k = initial_balance / 1000\n",
        "mean_k = mean_balance / 1000\n",
        "median_k = median_balance / 1000\n",
        "\n",
        "ax.axvline(x=initial_balance, color='red', linestyle='--', linewidth=3, \n",
        "           label=f'Initial: ${initial_k:.0f}K', zorder=10, alpha=0.9)\n",
        "ax.axvline(x=mean_balance, color='green', linestyle='--', linewidth=3, \n",
        "           label=f'Mean: ${mean_k:.0f}K', zorder=10, alpha=0.9)\n",
        "ax.axvline(x=median_balance, color='orange', linestyle='--', linewidth=3, \n",
        "           label=f'Median: ${median_k:.0f}K', zorder=10, alpha=0.9)\n",
        "\n",
        "ax.set_xlabel('Final Balance ($)', fontsize=13, fontweight='bold')\n",
        "ax.set_ylabel('Frequency (Number of Simulations)', fontsize=13, fontweight='bold')\n",
        "ax.set_title('Distribution of Final Balances (100 Simulations)', \n",
        "             fontsize=15, fontweight='bold', pad=15)\n",
        "ax.grid(True, alpha=0.3, axis='both', linestyle=':', linewidth=0.8)\n",
        "\n",
        "ax.legend(fontsize=11, framealpha=0.9, loc='upper right')\n",
        "ax.tick_params(labelsize=11)\n",
        "\n",
        "# Clean up spines\n",
        "ax.spines['top'].set_visible(False)\n",
        "ax.spines['right'].set_visible(False)\n",
        "ax.spines['left'].set_linewidth(1.2)\n",
        "ax.spines['bottom'].set_linewidth(1.2)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Print statistics\n",
        "print(f\"\\nStatistics from 100 simulations:\")\n",
        "print(f\"Mean final balance: ${mean_balance:,.2f}\")\n",
        "print(f\"Median final balance: ${median_balance:,.2f}\")\n",
        "print(f\"Probability (final balance > $30,000): {prob_above_30k:.3f} ({prob_above_30k*100:.1f}%)\")\n",
        "print(f\"Minimum final balance: ${np.min(final_balances):,.2f}\")\n",
        "print(f\"Maximum final balance: ${np.max(final_balances):,.2f}\")"
      ],
      "id": "q3-dist-100-py",
      "execution_count": null,
      "outputs": []
